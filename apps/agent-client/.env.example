# GUI ↔ qe-agent local IPC socket path (default /run/qe-agent/agent.sock).
# Development: QE_AGENT_IPC_SOCKET=/tmp/qe-agent-dev.sock pnpm tauri dev
QE_AGENT_IPC_SOCKET=/run/qe-agent/agent.sock

# The P3 GUI has no Vite/runtime env vars of its own; daemon configuration
# (mTLS URL, device slot, data dir, ...) lives in the backend qe-agent service.
