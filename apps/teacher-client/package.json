{
  "name": "qe-teacher-client",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm version:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "tauri": "tauri",
    "tauri:x11": "GDK_BACKEND=x11 tauri dev",
    "test:e2e": "playwright test",
    "test:desktop": "bash scripts/desktop-smoke.sh",
    "test:update-server": "node scripts/test-update-server.mjs",
    "update:serve": "node tools/update-server/server.mjs",
    "update:serve:tls": "node tools/update-server/server.mjs --tls",
    "update:certs": "bash scripts/gen-dev-certs.sh",
    "update:publish": "node scripts/publish-local-update.mjs",
    "test:e2e:ui": "playwright test --ui",
    "version:check": "node scripts/check-versions.mjs",
    "manifest:update": "node scripts/make-update-manifest.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.21.0",
  "description": "QEStudio teacher console desktop client"
}
