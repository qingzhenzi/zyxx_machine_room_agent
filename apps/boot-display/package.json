{
  "name": "boot-display",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "oxlint src",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:x11": "GDK_BACKEND=x11 tauri dev",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.5"
  }
}
